PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/hms3
JWT_SECRET=replace-with-a-long-random-string
IDLE_MINUTES=15
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
DEFAULT_ACCOUNT_PASSWORD=replace-with-a-temporary-password
SEED_DEMO=true
# Hospital local time as minutes from UTC: 0 = UTC, 330 = India (IST). Affects weekdays and "today".
HOSPITAL_TZ_OFFSET_MINUTES=0
