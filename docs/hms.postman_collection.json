{
  "info": {
    "name": "HMS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "patientId",
      "value": ""
    },
    {
      "key": "doctorId",
      "value": ""
    },
    {
      "key": "appointmentId",
      "value": ""
    },
    {
      "key": "billId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login (run first)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"admin\",\n  \"username\": \"admin\",\n  \"password\": \"Admin@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/dashboard",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "dashboard"
          ]
        }
      }
    },
    {
      "name": "List doctors",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = pm.response.json(); if (d.length) pm.collectionVariables.set(\"doctorId\", d[0]._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/doctors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doctors"
          ]
        }
      }
    },
    {
      "name": "Search patients",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const p = pm.response.json(); if (p.length) pm.collectionVariables.set(\"patientId\", p[0]._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients?q=ravi",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ],
          "query": [
            {
              "key": "q",
              "value": "ravi"
            }
          ]
        }
      }
    },
    {
      "name": "Create patient",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"patientId\", pm.response.json()._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"age\": 45,\n  \"gender\": \"male\",\n  \"contact\": \"9876543210\",\n  \"condition\": \"Diabetes\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/patients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ]
        }
      }
    },
    {
      "name": "Patient record",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/{{patientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "{{patientId}}"
          ]
        }
      }
    },
    {
      "name": "Add history (doctor login)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"diagnosis\": \"Diabetes\",\n  \"prescription\": \"Metformin\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/patients/{{patientId}}/history",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "{{patientId}}",
            "history"
          ]
        }
      }
    },
    {
      "name": "Add lab report",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"testName\": \"HbA1c\",\n  \"result\": \"7.0 %\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/patients/{{patientId}}/lab-reports",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "{{patientId}}",
            "lab-reports"
          ]
        }
      }
    },
    {
      "name": "Create doctor (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Smith\",\n  \"specialization\": \"Cardiology\",\n  \"contact\": \"9000000003\",\n  \"fee\": 80000,\n  \"availability\": [\n    \"Mon\",\n    \"Wed\",\n    \"Fri\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/doctors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doctors"
          ]
        }
      }
    },
    {
      "name": "Book appointment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"appointmentId\", pm.response.json()._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patient\": \"{{patientId}}\",\n  \"doctor\": \"{{doctorId}}\",\n  \"date\": \"2030-01-07T10:00:00.000Z\",\n  \"reason\": \"Check-up\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/appointments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "appointments"
          ]
        }
      }
    },
    {
      "name": "Approve appointment (doctor login)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/appointments/{{appointmentId}}/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "appointments",
            "{{appointmentId}}",
            "approve"
          ]
        }
      }
    },
    {
      "name": "Reject appointment (doctor login)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"note\": \"Doctor unavailable\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/appointments/{{appointmentId}}/reject",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "appointments",
            "{{appointmentId}}",
            "reject"
          ]
        }
      }
    },
    {
      "name": "Reschedule appointment (doctor login)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"2030-01-09T11:00:00.000Z\",\n  \"note\": \"Moved to Wednesday\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/appointments/{{appointmentId}}/reschedule",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "appointments",
            "{{appointmentId}}",
            "reschedule"
          ]
        }
      }
    },
    {
      "name": "Complete appointment (doctor login)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/appointments/{{appointmentId}}/complete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "appointments",
            "{{appointmentId}}",
            "complete"
          ]
        }
      }
    },
    {
      "name": "Generate bill",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"billId\", pm.response.json()._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patient\": \"{{patientId}}\",\n  \"items\": [\n    {\n      \"category\": \"test\",\n      \"description\": \"Blood sugar\",\n      \"quantity\": 1,\n      \"unitPrice\": 15000\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bills",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "bills"
          ]
        }
      }
    },
    {
      "name": "Pay bill (paise)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 5000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bills/{{billId}}/pay",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "bills",
            "{{billId}}",
            "pay"
          ]
        }
      }
    },
    {
      "name": "Daily appointments CSV",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reports/appointments.csv?date=2030-01-07",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reports",
            "appointments.csv"
          ],
          "query": [
            {
              "key": "date",
              "value": "2030-01-07"
            }
          ]
        }
      }
    },
    {
      "name": "Audit trail (admin)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/audit?limit=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "audit"
          ],
          "query": [
            {
              "key": "limit",
              "value": "50"
            }
          ]
        }
      }
    }
  ]
}